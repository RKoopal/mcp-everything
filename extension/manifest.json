{
  "manifest_version": 3,
  "name": "MCP Everything – recorder",
  "version": "0.9.2",
  "description": "Records a site you choose. The connector server makes tools from it, and links your session when you ask.",
  "key": "",
  "permissions": ["webRequest", "storage", "activeTab", "cookies", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "externally_connectable": { "matches": ["https://mcp-everything.com/*"] },
  "action": { "default_title": "MCP Everything – recorder", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "devtools_page": "devtools.html"
}

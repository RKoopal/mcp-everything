# Copy to .env and fill in. .env does not go into git.

# 32 random bytes in base64. The vault is encrypted with it: lose it and you lose all sessions.
# Make one with: openssl rand -base64 32
CONNECTOR_SECRET_KEY=

# The address where users reach the server. Connect links start with it.
PUBLIC_URL=http://127.0.0.1:8000

# For the pipeline (recording -> tools). Without a key, everything works except making tools from a recording.
ANTHROPIC_API_KEY=

# Limits for who made an account themselves with an invite (python -m connector.users invite).
# Accounts from an admin (python -m connector.users add) have no limits.
# MAX_USERS=25                 all accounts together; after that no invite works
# MAX_RECORDINGS_PER_MONTH=5   per user, the last 30 days; only recordings that called Claude
# REVIEW_GUEST_TOOLS=1         only a guest sees the guest's tools, until a review (python -m connector.registry)
